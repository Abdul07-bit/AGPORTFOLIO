# Copy to `.env.local` and fill in what you need. Every value is optional.

# Public production URL, without a trailing slash (e.g. https://your-domain.com).
# When set, the build adds canonical/Open Graph URLs, JSON-LD and generates sitemap.xml.
VITE_SITE_URL=

# Optional form endpoint that accepts a JSON POST (Formspree, Getform, a serverless function...).
# Without it, the contact form falls back to opening the visitor's email app (needs `email` in src/data/profile.ts).
VITE_CONTACT_ENDPOINT=

# ─── Admin panel (/admin) — server-side only, never exposed to the browser ───
# Generate all three with: npm run admin:credentials -- you@example.com
# Then add the same values in Netlify → Site configuration → Environment variables.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
